<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/next"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:nextFocusLeft="@id/repeat"
            android:text="@string/play_next" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/prev"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_prev" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/episodes"
            style="@style/Control"
            android:layout_marginEnd="12dp"
            android:text="@string/play_episodes"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/discMenu"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/disc_menu_open_hint"
            android:text="@string/disc_menu_open"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reset"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_reset" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/search"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_search" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/change2"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_change"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/fullscreen"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_fullscreen" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_exo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/decode"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_decode" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/playParams"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_params" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/multiThreadProxy"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/multi_thread_proxy_button" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panDiagnostic"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/pan_diagnostic_title"
            android:text="@string/pan_diagnostic_entry"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/codecCapability"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/codec_capability_short" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/speed"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:fontFeatureSettings="tnum"
            android:text="@string/play_speed" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scale"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_scale" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/actionQuality"
            style="@style/Control"
            android:layout_marginEnd="12dp"
            android:text="@string/detail_quality"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/lut"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_lut" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/karaoke"
            style="@style/Control"
            android:layout_marginEnd="12dp"
            android:text="@string/player_karaoke_mode"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/immersiveAudio"
            style="@style/Control"
            android:layout_marginEnd="12dp"
            android:text="@string/player_immersive_audio_mode"
            android:visibility="gone" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/text"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="3"
            android:text="@string/play_track_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audio"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="1"
            android:text="@string/play_track_audio" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/video"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="2"
            android:text="@string/play_track_video" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/opening"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_op" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/ending"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_ed" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/danmaku"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/danmaku"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/adFeedback"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_ad_feedback"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_title"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cast"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_cast" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timer"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_timer" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/repeat"
            style="@style/Control"
            android:nextFocusRight="@id/next"
            android:text="@string/play_repeat" />

    </LinearLayout>
</HorizontalScrollView>
