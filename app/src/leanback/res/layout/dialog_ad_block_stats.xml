<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_shell_proxy_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ad_block_stats"
        android:textColor="@color/dialog_outlined_button_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/statsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_ad_stats_tabs"
        android:minHeight="52dp"
        android:overScrollMode="never"
        app:tabGravity="fill"
        app:tabIndicatorColor="#1A73E8"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="#1A73E8"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Button"
        app:tabTextColor="#5F6368" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/shape_ad_stats_content">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/overviewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_stats_overview"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/totalBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_block_total"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/aiFeedbackCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_feedback_count"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/aiSuccessRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_ai_success_rate"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/black_10" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/ad_site_overview"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/siteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_site_count"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/topSite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="-"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_top_site"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/topSiteShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/dialog_outlined_button_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ad_top_site_share"
                            android:textColor="#5F6368"
                            android:textSize="15sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sitePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/siteRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/siteRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/rulePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ruleRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ruleRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/pipelinePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pipelineRankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pipelineRankRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/logPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/logEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:visibility="gone" />
            <HorizontalScrollView
                android:id="@+id/logTableScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="88dp"
            android:background="@color/black_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_site_name"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/siteFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_site_domain"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/siteDomainFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_playback_context"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vodFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_line_name"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lineFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_episode_name"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/episodeFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_rule_domain"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ruleFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_ad_domain"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adDomainFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_blocked_at"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/blockedAtFilter"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_dialog_input"
                    android:hint="@string/ad_log_filter_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textColorHint="#80868B"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_segment_start"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/segmentStartFilter"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_dialog_input"
                    android:hint="@string/ad_log_filter_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textColorHint="#80868B"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_segment_end"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/segmentEndFilter"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_dialog_input"
                    android:hint="@string/ad_log_filter_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textColorHint="#80868B"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_segment_duration"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/segmentDurationFilter"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_dialog_input"
                    android:hint="@string/ad_log_filter_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textColorHint="#80868B"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_log_pipeline"
                    android:textColor="@color/dialog_outlined_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pipelineFilter"
                    style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/ad_log_filter_hint"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:cornerRadius="4dp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/logRecycler"
                        android:layout_width="1660dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </HorizontalScrollView>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/chartPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chartEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad_stats_empty"
                android:textColor="#5F6368"
                android:textSize="15sp"
                android:visibility="gone" />
            <com.fongmi.android.tv.widget.AdBlockChartView
                android:id="@+id/chartView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_10" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.WebHTV.LightDialog.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:minWidth="112dp"
            android:text="@string/ad_stats_reset"
            android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="112dp"
            android:text="@android:string/cancel"
            android:textColor="@color/dialog_primary_button_text"
            android:textSize="15sp"
            app:backgroundTint="@color/dialog_primary_button_bg" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
