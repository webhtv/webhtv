<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_danmaku_sheet_glass_panel"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/danmaku_select"
            android:textColor="?attr/webhtvColorOnWallpaper"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/selector_glass_icon_action"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_action_search"
            android:visibility="gone" />

        <!--
            开关的焦点环必须画在**不受 scale 影响的宿主**上：MaterialSwitch 自身
            scaleX/scaleY=0.72 是为了缩小 track/thumb，若把背景挂在它身上，焦点框会被
            一起缩到 72%，于是出现「开关的边框比其它按钮细」的不一致。这里用一层
            FrameLayout 承载焦点环（不缩放），开关只做视觉缩放，焦点态仍由宿主表达。
        -->
        <FrameLayout
            android:id="@+id/loadHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_glass_icon_action"
            android:clickable="true"
            android:contentDescription="@string/danmaku_load"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp">

            <!--
                开关本身不再聚焦：焦点由外层 loadHost 承载。若把 focusable 留在开关上，
                宿主的 background 收不到 state_focused，焦点环永远不会出现（真机复核过）。
                点击/遥控确定由 loadHost 转发到 setChecked，见 DanmakuDialog。
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:scaleX="0.72"
                android:scaleY="0.72" />

        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_glass_icon_action"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_action_choose" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_glass_icon_action"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_danmaku_setting" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:maxHeight="204dp"
        tools:listitem="@layout/adapter_danmaku" />

</androidx.appcompat.widget.LinearLayoutCompat>
