<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/exo"
            style="@style/Player.Live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/osd"
            layout="@layout/view_player_osd"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/recycler"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/shape_live_list"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.CustomLiveListView
            android:id="@+id/group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="100dp"
            android:maxWidth="220dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="12dp"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_group" />

        <com.fongmi.android.tv.ui.custom.CustomLiveListView
            android:id="@+id/channel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="120dp"
            android:maxWidth="260dp"
            android:clipChildren="false"
            android:translationX="-12dp"
            android:clipToPadding="false"
            android:padding="12dp"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_channel" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/program"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/selector_live"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusLeft="@id/channel"
            android:nextFocusRight="@id/epgData"
            android:orientation="vertical"
            android:visibility="gone">
 
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/live_program_vertical"
                android:textColor="@color/text"
                android:textSize="16sp" />
 
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="»"
                android:textColor="@color/text"
                android:textSize="18sp" />
 
        </androidx.appcompat.widget.LinearLayoutCompat>
 
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <com.fongmi.android.tv.ui.custom.CustomLiveListView
                android:id="@+id/epgData"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:nextFocusLeft="@id/program"
                android:padding="12dp"
                android:visibility="gone"
                tools:itemCount="5"
                tools:listitem="@layout/adapter_epg_data" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/epgDate"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/shape_epg_date"
                android:ellipsize="marquee"
                android:focusable="false"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/epg_date"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="10-08 周三 · 今天"
                tools:visibility="visible" />

        </FrameLayout>
 
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
