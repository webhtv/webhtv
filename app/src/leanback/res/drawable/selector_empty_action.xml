<?xml version="1.0" encoding="utf-8"?>
<!--
    电视端空态主按钮的背景。

    焦点/按下态走应用表面族的焦点环（shape_empty_action_focused），常态复用
    shape_button_normal（透明填充 + 1dp white_30 描边），与电视端其余胶囊按钮同形。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/shape_empty_action_focused" android:state_focused="true" />
    <item android:drawable="@drawable/shape_empty_action_focused" android:state_pressed="true" />
    <item android:drawable="@drawable/shape_button_normal" />
</selector>
