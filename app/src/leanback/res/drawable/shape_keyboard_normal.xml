<?xml version="1.0" encoding="utf-8"?>
<!--
    电视版搜索键盘按键的常态底。

    底色必须是**能压住浅色壁纸**的半透明黑：文字是 ?attr/webhtvColorOnWallpaper（恒定浅色），
    而键盘直接铺在用户壁纸/画布上，没有表面层兜底。
    实测（192.0.2.0:5561 模拟器，1920x1080，浅色壁纸）：
      black_20（#33000000）→ 键底 #7B768C、白字 4.36:1，低于正文 4.5:1 门槛；
      black_40（#66000000）→ 键底约 #5C5969、白字约 6.6:1。
    判据与同族说明见 docs/TV-FOCUS-PAIR-20261021.md §7：
    这是「恒定浅色前景压在壁纸上的半透明宿主」这一类里唯一只作用于搜索键盘的实例，
    故只上调本 drawable，不去改动全应用表面共用的 shape_item_normal（那是另一项全局决策）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/black_40" />

    <corners android:radius="4dp" />

</shape>
