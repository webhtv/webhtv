<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_success_container" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_success" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_outline_variant" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_outline_variant" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_surface_container" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_outline_variant" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
