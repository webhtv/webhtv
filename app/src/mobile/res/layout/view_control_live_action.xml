<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:scrollbars="none">

    <!-- container 供 PlayerButtonSetting.applyOrder 重排播放器按钮，直播专属按钮（配置/直播源/线路等）不登记。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/config"
            style="@style/Control"
            android:text="@string/play_config" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/source"
            style="@style/Control"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:text="@string/live_control_source" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player"
            style="@style/Control"
            android:text="@string/play_exo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/decode"
            style="@style/Control"
            android:text="@string/play_decode" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/playParams"
            style="@style/Control"
            android:text="@string/play_params" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/speed"
            style="@style/Control"
            android:fontFeatureSettings="tnum"
            android:text="@string/play_speed"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scale"
            style="@style/Control"
            android:text="@string/play_scale" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/line"
            style="@style/Control"
            tools:text="來源 1" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            style="@style/Control"
            android:tag="3"
            android:text="@string/play_track_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audio"
            style="@style/Control"
            android:tag="1"
            android:text="@string/play_track_audio" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/video"
            style="@style/Control"
            android:tag="2"
            android:text="@string/play_track_video" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/invert"
            style="@style/Control"
            android:text="@string/play_invert" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/across"
            style="@style/Control"
            android:text="@string/play_across" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/change"
            style="@style/Control"
            android:text="@string/play_change" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</HorizontalScrollView>
