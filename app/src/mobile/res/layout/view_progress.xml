<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        指示器颜色改走语义角色：此前写死 @color/white，与同屏其它状态元素
        （traffic 文字、空态标题）用的 ?attr/webhtvColorOnWallpaper 是两份声明。
        设计文档 §9.9 要求「加载使用统一 spinner/progress……不使用多种颜色动画」。
    -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/webhtvColorOnWallpaper" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:textColor="?attr/webhtvColorOnWallpaper"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="120 KB/s"
        tools:visibility="visible" />

</FrameLayout>