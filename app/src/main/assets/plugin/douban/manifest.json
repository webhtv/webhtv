{
  "protocol": "webhtv-plugin",
  "version": 1,
  "id": "douban.comments",
  "name": "豆瓣短评",
  "sdk": 1,
  "runtime": { "api": "js", "entry": "assets://plugin/douban/douban.js", "timeout": 20 },
  "params": { "count": 20 },
  "events": ["ui.contentShown"],
  "ui": [
    {
      "slot": "panel",
      "label": "豆瓣",
      "action": "douban.comments",
      "event": "ui.contentShown",
      "surfaces": ["detail", "playback"]
    }
  ],
  "permissions": ["plugin.events", "plugin.data.episode", "net.request", "ui.panel"]
}
