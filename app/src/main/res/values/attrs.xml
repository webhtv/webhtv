<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        原生增强播放页的统一焦点语义属性。TV 的 colorPrimary 固定为白色，且同时驱动着
        ~100 个布局的聚焦文字色，不能拿来表达“焦点环”，所以单独给出三个可被主题覆写的属性。
        取值见 app/src/main/res/values/colors.xml 的 tv_item_*，leanback Theme.Base 负责绑定。
    -->
    <attr name="tvFocusRing" format="color" />
    <attr name="tvCurrentRing" format="color" />
    <attr name="tvNormalStroke" format="color" />
    <!--
        播放页（视频层）环色。播放页控制条**直接叠在视频上**，而控制面板/快捷搜索/选集面板
        又是固定深靛玻璃（三档渐变 #E62F315E→#D6282955→#CC303463）：浅色表的 FOCUS 深蓝
        在玻璃上只有 1.83:1（dev1 实机实测），焦点环会看不见。因此播放页环色是一个
        **在固定深色玻璃上做过可读性夹取**的主题派生色（保持用户 FOCUS / playerCurrent 槽的
        色相与彩度、只走明度到 ≥3:1），而不是直接把 ?attr/tvFocusRing 搬过来。

        夹取背景只有上面那三档固定玻璃，**纯白视频（雪/白墙）刻意不在约束里**：把它也算进去
        会把深色表的近白环压成灰蓝，同一页就出现两种高亮色。取舍与理由见
        ThemeResolver.PLAYER_RING_BACKDROPS 的注释。

        取值见 colors.xml 的 tv_player_*，由 ThemeResolver 从主题槽位派生；
        leanback / mobile 的 Theme.Base 负责把属性绑到该取值。
    -->
    <attr name="tvPlayerRing" format="color" />
    <attr name="tvPlayerCurrentRing" format="color" />

    <declare-styleable name="CustomRecyclerView">
        <attr name="android:minWidth" />
        <attr name="android:minHeight" />
        <attr name="maxWidth" format="dimension" />
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CustomNestedScrollView">
        <attr name="android:minHeight" />
        <attr name="maxHeight" />
    </declare-styleable>
</resources>
