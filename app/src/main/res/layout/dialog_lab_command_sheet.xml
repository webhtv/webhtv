<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="640dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:id="@+id/sheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/sheetRunningTag"
            android:background="@drawable/shape_lab_running_tag"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lab_running"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheetScroll"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/sheetDesc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sheetVariables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sheetDownloadContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/sheetDownloadLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下载地址"/>
                <EditText
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/sheetDownloadUrl"
                    android:background="@drawable/shape_lab_command_bg"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:inputType="textUri"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <EditText
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/sheetCommandPreview"
                android:background="@drawable/shape_lab_command_bg"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:singleLine="true"
                android:inputType="text"
                android:fontFamily="monospace"/>
            <HorizontalScrollView
                android:id="@+id/sheetClicksScroll"
                android:visibility="gone"
                android:scrollbars="none"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:requiresFadingEdge="horizontal">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/sheetClicksContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/sheetBtnEdit"
            android:background="@drawable/shape_lab_click_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="编辑"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/sheetBtnStop"
            android:background="@drawable/shape_lab_stop_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/lab_stop"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/sheetBtnOutput"
            android:background="@drawable/shape_lab_click_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="输出"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/sheetBtnRun"
            android:background="@drawable/shape_lab_run_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/lab_run"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </LinearLayout>
</LinearLayout>
