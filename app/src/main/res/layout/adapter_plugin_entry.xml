<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/selector_dialog_surface_row"
    android:orientation="horizontal"
    android:padding="12dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/entryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            tools:text="example.hello" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/entryMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            tools:text="版本 1.0.0 · 运行时 js · 启用" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/entryEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:focusable="true"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/entryParams"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/selector_dialog_switch"
        android:contentDescription="@string/plugin_manager_params"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_action_setting"
        app:tint="@color/plugin_manager_action_icon" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/entryDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/selector_dialog_switch"
        android:contentDescription="@string/setting_delete"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_action_delete"
        app:tint="@color/plugin_manager_action_icon" />
</androidx.appcompat.widget.LinearLayoutCompat>
