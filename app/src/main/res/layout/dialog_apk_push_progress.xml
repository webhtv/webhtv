<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_shell_proxy_dialog"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="26dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apk_push_url_progress_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/apk_push_url_progress_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:lineSpacingExtra="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        tools:text="正在接收 46% · 61 MB / 133 MB&#10;3.2 MB/s · 剩余 00:23 · 已用 00:12" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:max="100"
        android:progress="0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="@string/apk_push_url_cancel"
        android:textAllCaps="false"
        android:textColor="@color/dialog_primary_button_text"
        android:textSize="15sp"
        app:backgroundTint="@color/dialog_primary_button_bg"
        app:strokeWidth="@dimen/webhtv_focus_ring_width"
        app:strokeColor="@color/focus_ring_primary_container"
        app:cornerRadius="8dp" />

</androidx.appcompat.widget.LinearLayoutCompat>
