<?xml version="1.0" encoding="utf-8"?>
<!-- TMDB 推荐影片卡片：竖版海报 + 标题 + 分来源评分 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="108dp"
    android:layout_height="162dp"
    android:layout_marginEnd="12dp"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:stateListAnimator="@null"
    app:cardBackgroundColor="#1C2530"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:rippleColor="@android:color/transparent"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1C2530"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@color/black" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/recommendationTextPanel"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_gravity="bottom"
                android:background="@drawable/shape_tmdb_recommendation_info"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="白月光" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <LinearLayout
                android:id="@+id/ratingGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:divider="@drawable/divider_rating_chip_vertical"
                android:gravity="end"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tmdbRating"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/shape_tmdb_recommendation_rating_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="#FFD35C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="TMDB 8.3"
                    tools:visibility="visible" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/doubanRating"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/shape_tmdb_recommendation_rating_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="#78E08F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="豆瓣 8.7"
                    tools:visibility="visible" />

            </LinearLayout>

        </FrameLayout>

</com.google.android.material.card.MaterialCardView>
