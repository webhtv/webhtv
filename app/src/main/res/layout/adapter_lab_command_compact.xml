<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shape_lab_card"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">
    <View
        android:id="@+id/statusDot"
        android:background="@drawable/shape_lab_status_dot_idle"
        android:layout_width="8dp"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="10dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:id="@+id/runningTag"
        android:background="@drawable/shape_lab_running_tag"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lab_running"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnAction"
        android:background="@drawable/shape_lab_run_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/lab_run"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginStart="10dp"/>
</LinearLayout>
