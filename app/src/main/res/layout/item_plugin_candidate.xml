<?xml version="1.0" encoding="utf-8"?>
<!--
  候选插件行：整行可聚焦、可点，勾选框不抢焦点。

  CheckBox 被刻意设成 focusable=false / clickable=false：遥控器的方向键要能在行之间上下移动，
  一旦勾选框自己拿焦点，按一次"选中"只翻一行，再按方向键焦点就卡在勾选框与行之间；
  而触摸点在勾选框上时，事件会自然落到可点的父行，两种输入都只有一条路径。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/selector_dialog_surface_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/candidateCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clickable="false"
        android:focusable="false" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/candidateName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            tools:text="豆瓣" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/candidateMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="版本 1.0.0 · 运行时 js" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/candidatePermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="联网 · net.request · 播放面板绘制（ui.panel）" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
