<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#111111"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="2dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/btnBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_action_back"
            android:contentDescription="返回"
            app:tint="#888888"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#999999"
            android:ellipsize="end"
            android:id="@+id/termTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:layout_marginStart="2dp"/>
        <ImageView
            android:id="@+id/btnClear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="5dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_action_delete"
            android:contentDescription="清屏"
            app:tint="#666666"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/termScroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <TextView
            android:textSize="12sp"
            android:textColor="#aaffaa"
            android:id="@+id/termOutput"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </ScrollView>
    <HorizontalScrollView
        android:id="@+id/historyScroll"
        android:background="#0a0a0a"
        android:visibility="gone"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/historyContainer"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </HorizontalScrollView>
    <HorizontalScrollView
        android:id="@+id/shortcutScroll"
        android:background="#111111"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/shortcutContainer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </HorizontalScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#111111"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#aaffaa"
            android:id="@+id/termPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:fontFamily="monospace"/>
        <EditText
            android:textSize="13sp"
            android:textColor="#eeeeee"
            android:textColorHint="#444444"
            android:id="@+id/termInput"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:fontFamily="monospace"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:id="@+id/btnSend"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_action_send"
            android:contentDescription="发送"
            app:tint="#aaffaa"/>
    </LinearLayout>
</LinearLayout>
