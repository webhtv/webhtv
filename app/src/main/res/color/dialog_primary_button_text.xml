<?xml version="1.0" encoding="utf-8"?>
<!--
    弹窗主按钮的文字色。必须与 dialog_primary_button_bg 的**同一状态分支**配对：
    聚焦/按下时填充翻成深色 primary_container，文字随之取 on_primary_container
    （夜间 #D3E3FD / #0842A0 = 7.04:1；浅色 #041E49 / #D3E3FD = 12.57:1）。
    默认态填充是浅色 primary，文字仍取 on_primary（夜间 7.50:1 / 浅色 6.39:1）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/webhtv_color_on_surface_variant" android:state_enabled="false" />
    <item android:color="@color/webhtv_color_on_primary_container" android:state_focused="true" />
    <item android:color="@color/webhtv_color_on_primary_container" android:state_pressed="true" />
    <item android:color="@color/webhtv_color_on_primary" />
</selector>
