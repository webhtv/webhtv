<?xml version="1.0" encoding="utf-8"?>
<!--
    版本卡版本号行的次要文字色。

    与 update_version_item_title 同一条规则：聚焦填充是 colorPrimary，
    文字必须取它的配对 on-色，否则 colorOnSurfaceVariant 在浅色 primary 上
    只有 1.01:1（夜间）/ 1.46:1（浅色）。默认填充是表面色，故回到 variant。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/webhtv_color_on_primary" android:state_focused="true" />
    <item android:color="@color/webhtv_color_on_primary" android:state_pressed="true" />
    <item android:color="@color/webhtv_color_on_surface_variant" />
</selector>
