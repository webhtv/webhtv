<?xml version="1.0" encoding="utf-8"?>
<!-- Stable surface keeps child text readable when a row, or one of its actions, takes focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="8dp" />
            <stroke android:width="@dimen/webhtv_focus_ring_width" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="8dp" />
            <stroke android:width="@dimen/webhtv_focus_ring_width" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</selector>
