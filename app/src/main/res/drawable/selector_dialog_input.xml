<?xml version="1.0" encoding="utf-8"?>
<!--
    输入框底材。圆角取设计文档 §7.1 的 shapeSmall = 8dp（"列表项、输入框、普通按钮"）。

    改动前这里是 4dp，即 §7.1 里属于"标签、微小 chip"的 shapeExtraSmall 档——输入框被放到了
    小一档的位置上，是全库范围内对 §7.1 尺度表的一处纯粹偏离（不像卡片圆角那样另有约束，
    见 §7.1 的补充说明）。两处（focused / 常态）必须同步改，否则聚焦时会跳一下圆角。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutline" />
        </shape>
    </item>
</selector>
