<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_surface_container_highest" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_outline_variant" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_primary_container" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/webhtv_color_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_primary_container" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/webhtv_color_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_surface_container_high" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/webhtv_color_outline_variant" />
        </shape>
    </item>
</selector>
