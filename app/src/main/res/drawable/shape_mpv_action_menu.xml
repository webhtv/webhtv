<?xml version="1.0" encoding="utf-8"?>
<!--
    MPV 配置项的「重命名 / 删除」操作弹出菜单。

    原本写死白底 + 固定灰描边，而 MpvConfigDialog.actionItem 的文字也是硬编码深色，
    两者自洽。现在文字已改为跟随调色板的语义前景（onSurface / error），
    菜单底色必须同步跟随，否则夜间会出现「近黑底 + 近黑字」。
    这里用与对话框面板同族的 colorSurfaceContainerLowest。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerLowest" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp" />
</shape>
