<?xml version="1.0" encoding="utf-8"?>
<!--
    剧照详情（dialog_episode_detail 的 @id/stillCard）焦点环。

    圆角 = 宿主圆角 − w/2：宿主 CardView 是 app:cardCornerRadius="8dp"，而本 drawable 是它的
    foreground，环**外边界**圆角半径 = 声明值 + w/2 = 9.5dp，比宿主 8dp 弧大，宿主圆角会
    露出环外一段。故声明 8 − 1.5 = 6.5dp。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="6dp" />

    <stroke
        android:width="3dp"
        android:color="?attr/tvFocusRing" />

</shape>
